{
  "name": "cortex-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cortex meeting-capture watcher daemon for the Mac mini.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "dry-run": "tsx src/dry-run.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "p-retry": "^6.2.0",
    "node-cron": "^3.0.3",
    "gray-matter": "^4.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "vitest": "^2.1.0",
    "@types/node": "^20.16.0",
    "@types/node-cron": "^3.0.11"
  },
  "engines": { "node": ">=20" }
}
